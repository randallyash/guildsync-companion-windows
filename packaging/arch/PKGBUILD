# Maintainer: Randall Yash <me@randallyash.com>
pkgname=guildsync-companion-git
pkgver=0.1.5.r0.g0000000
pkgrel=1
pkgdesc="Uploads GuildSync saved data to twilighttavern.co. Does not modify the World of Warcraft client."
arch=('x86_64')
url="https://forgejo.fifthdread.com/Ramzal/guildsync-companion"
license=('MIT')
depends=('fontconfig' 'libx11' 'libice' 'libsm')
makedepends=('dotnet-sdk' 'git')
provides=('guildsync-companion')
conflicts=('guildsync-companion')
options=('!strip' '!debug')
source=("guildsync::git+https://forgejo.fifthdread.com/Ramzal/guildsync-companion.git#branch=main")
sha256sums=('SKIP')

pkgver() {
  cd "$srcdir/guildsync"
  local ver count commit
  ver=$(sed -n 's:.*<Version>\([^<]*\)</Version>.*:\1:p' src/GuildSync.Companion/GuildSync.Companion.csproj | head -1)
  count=$(git rev-list --count HEAD)
  commit=$(git rev-parse --short HEAD)
  printf "%s.r%s.g%s" "$ver" "$count" "$commit"
}

build() {
  cd "$srcdir/guildsync"
  export DOTNET_CLI_TELEMETRY_OPTOUT=1
  export DOTNET_NOLOGO=1
  dotnet publish src/GuildSync.Companion -c Release -r linux-x64 --self-contained true \
    -p:DebugType=none -p:DebugSymbols=false \
    -o "$srcdir/publish"
}

package() {
  install -d "$pkgdir/usr/lib/guildsync-companion" "$pkgdir/usr/bin"
  cp -a "$srcdir/publish"/. "$pkgdir/usr/lib/guildsync-companion/"
  chmod 755 "$pkgdir/usr/lib/guildsync-companion/GuildSyncCompanion"
  cat > "$pkgdir/usr/bin/guildsync-companion" << 'EOF'
#!/bin/sh
exec /usr/lib/guildsync-companion/GuildSyncCompanion "$@"
EOF
  chmod 755 "$pkgdir/usr/bin/guildsync-companion"

  install -Dm644 "$srcdir/guildsync/src/GuildSync.Companion/Assets/crest.png" \
    "$pkgdir/usr/share/icons/hicolor/256x256/apps/guildsync-companion.png"
  install -d "$pkgdir/usr/share/applications"
  cat > "$pkgdir/usr/share/applications/guildsync-companion.desktop" << 'EOF'
[Desktop Entry]
Type=Application
Name=GuildSync Companion
Comment=Uploads GuildSync saved data to twilighttavern.co
Exec=guildsync-companion
Icon=guildsync-companion
Terminal=false
Categories=Game;
StartupWMClass=GuildSyncCompanion
EOF
  install -Dm644 "$srcdir/guildsync/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
